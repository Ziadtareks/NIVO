<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/nivo.ico</ApplicationIcon>
    <AssemblyName>NIVO.Local</AssemblyName>
    <RootNamespace>Nivo</RootNamespace>
    <Version>1.11.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Ziad Tarek</Copyright>
    <!-- This is a WPF application; the WinForms analyzer cannot see WPF's manifest-based DPI setup. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../docs/licenses/*" Link="Licenses/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="Nivo.Licenses.NIVO.txt" />
    <EmbeddedResource Include="../../docs/THIRD_PARTY_NOTICES.txt" LogicalName="Nivo.Licenses.Consolidated.txt" />
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../../docs/THIRD_PARTY_NOTICES.txt" Link="NIVO.THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="PdfPig" Version="0.1.11" />
  </ItemGroup>
</Project>
